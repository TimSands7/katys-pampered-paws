---
import { site } from '../data/site';

const pageUrl = site.facebookUrl.replace(/\/?$/, '');
---

<section id="gallery" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
	<div class="mx-auto max-w-2xl text-center">
		<span class="text-sm font-bold uppercase tracking-wide text-rose-500">Before &amp; After Gallery</span>
		<h2 class="mt-2 font-display text-3xl font-bold text-slate-800 sm:text-4xl">Fresh from the grooming table</h2>
		<p class="mt-4 text-slate-600">
			These photos are pulled straight from Katy's Facebook page, so new before-and-afters show up here
			automatically every time she posts &mdash; no waiting on us to update the site.
		</p>
	</div>

	<div class="mt-10 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
		<div class="rounded-3xl border border-slate-200 bg-white p-3 shadow-lg sm:p-4">
			<div id="fb-root"></div>
			<script
				async
				defer
				crossorigin="anonymous"
				src="https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v19.0"></script>
			<div
				class="fb-page mx-auto"
				data-href={pageUrl}
				data-tabs="timeline"
				data-width=""
				data-height="700"
				data-small-header="false"
				data-adapt-container-width="true"
				data-hide-cover="false"
				data-show-facepile="true"
			>
				<blockquote cite={pageUrl} class="fb-xfbml-parse-ignore">
					<a href={pageUrl} target="_blank" rel="noopener noreferrer">Katy's Pampered Paws</a>
				</blockquote>
			</div>
		</div>

		<div class="rounded-3xl bg-gradient-to-br from-teal-500 via-teal-500 to-purple-500 p-8 text-white shadow-lg">
			<h3 class="font-display text-2xl font-bold">Follow along on Facebook</h3>
			<p class="mt-3 text-teal-50">
				Katy posts new before-and-after transformations regularly. Give the page a follow so you never miss
				a glow-up &mdash; and message her there anytime with questions or photos of your own pet.
			</p>
			<a
				href={pageUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-teal-700 shadow-sm transition hover:bg-teal-50"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
					<path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z" />
				</svg>
				View on Facebook
			</a>
		</div>
	</div>
</section>

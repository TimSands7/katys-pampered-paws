---
import { site } from '../data/site';
---

<section id="contact" class="bg-slate-50 py-20">
	<div class="mx-auto max-w-4xl px-4 sm:px-6">
		<div class="overflow-hidden rounded-3xl bg-slate-900 shadow-xl">
			<div class="relative px-6 py-14 text-center sm:px-14">
				<div class="pointer-events-none absolute -left-10 -top-10 h-40 w-40 rounded-full bg-teal-500/30 blur-3xl"></div>
				<div class="pointer-events-none absolute -bottom-10 -right-10 h-40 w-40 rounded-full bg-purple-500/30 blur-3xl"></div>

				<span class="relative text-sm font-bold uppercase tracking-wide text-amber-300">Book an Appointment</span>
				<h2 class="relative mt-2 font-display text-3xl font-bold text-white sm:text-4xl">
					Ready to pamper your pet?
				</h2>
				<p class="relative mx-auto mt-4 max-w-xl text-slate-300">
					Call or text {site.phone} to check availability and book your pet's next grooming appointment in {site.area}.
				</p>

				<div class="relative mt-8 flex flex-wrap items-center justify-center gap-4">
					<a
						href={site.phoneHref}
						class="inline-flex items-center gap-2 rounded-full bg-teal-500 px-6 py-3 text-base font-bold text-white shadow-lg transition hover:bg-teal-400"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
							<path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z" />
						</svg>
						Call {site.phone}
					</a>
					<a
						href={site.facebookUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-base font-bold text-white ring-1 ring-white/30 transition hover:bg-white/20"
					>
						Message on Facebook
					</a>
				</div>

				<p class="relative mt-6 flex items-center justify-center gap-2 text-sm text-slate-400">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
						<path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" />
					</svg>
					Serving {site.area} and the surrounding area
				</p>
			</div>
		</div>
	</div>
</section>

---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero-photo.jpg';
import { site } from '../data/site';
---

<section id="top" class="relative overflow-hidden bg-slate-900">
	<Image
		src={heroPhoto}
		alt="A groomer carefully trimming a golden retriever's paw at Katy's Pampered Paws"
		width={2000}
		widths={[640, 1024, 1600, 2000]}
		sizes="100vw"
		class="absolute inset-0 h-full w-full object-cover opacity-70"
		loading="eager"
	/>
	<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-slate-900/20"></div>

	<div class="relative mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-24 sm:px-6 sm:py-32">
		<span class="inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-1.5 text-sm font-bold text-teal-700 shadow-sm">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
				<path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" />
			</svg>
			Proudly serving {site.area}
		</span>

		<h1 class="max-w-2xl font-display text-4xl font-bold leading-tight text-white sm:text-5xl md:text-6xl">
			Pampered pets, <span class="text-amber-300">happy tails.</span>
		</h1>

		<p class="max-w-xl text-lg text-slate-100 sm:text-xl">
			Gentle, professional grooming for dogs and cats of every breed and size &mdash; baths, full grooms, and
			all the extras that keep your best friend looking and feeling great.
		</p>

		<div class="flex flex-wrap gap-3 pt-2">
			<a
				href={site.phoneHref}
				class="inline-flex items-center gap-2 rounded-full bg-teal-500 px-6 py-3 text-base font-bold text-white shadow-lg shadow-teal-900/30 transition hover:bg-teal-400"
			>
				Call or Text {site.phone}
			</a>
			<a
				href="#services"
				class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-base font-bold text-slate-800 shadow-lg transition hover:bg-slate-100"
			>
				See Services &amp; Pricing
			</a>
		</div>
	</div>
</section>
